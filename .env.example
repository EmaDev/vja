# Dominio público del sitio, con esquema y sin barra final.
# Ej.: https://vjaplantas.com.ar — en desarrollo, http://localhost:3000
# Lo usan los QR de las etiquetas de producto: sin esta variable la impresión
# queda bloqueada, para no tirar papel con códigos que apuntan a la nada.
NEXT_PUBLIC_SITE_URL=

# Firebase client SDK (safe to expose to the browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (server only — from a service account JSON)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
