# Dominio público del sitio, con esquema y sin barra final.
# Ej.: https://vjaplantas.com.ar — en desarrollo, http://localhost:3000
#
# Dos usos, con tolerancias distintas a que falte:
#
# - Los QR de las etiquetas: sin esta variable la impresión queda bloqueada,
#   para no tirar papel con códigos que apuntan a la nada.
# - El SEO (canónicos, sitemap, robots y datos estructurados): acá no se puede
#   bloquear nada, así que si falta se cae a la URL que publica Vercel y, fuera
#   de Vercel, a localhost. Eso publica un sitio con los canónicos apuntando a
#   una dirección equivocada, que es un error silencioso: **cargala en
#   producción antes del primer deploy.**
NEXT_PUBLIC_SITE_URL=

# Cuántas plantas muestra la grilla del catálogo en la portada. El resto se ve
# en /catalogo, que es la lista completa con filtro por categoría y paginado.
# Entero positivo; vacío o mal escrito, se usan 15. El botón "Ver todo el
# catálogo" se muestra siempre, así que bajarlo no esconde nada.
LANDING_CATALOG_LIMIT=15

# Firebase client SDK (safe to expose to the browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (server only — from a service account JSON)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
