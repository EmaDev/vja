rules_version = '2';

// The public landing (src/app/page.tsx) reads `sites/{siteId}` through the
// Admin SDK on the Next.js server, which bypasses these rules entirely.
// Nothing in this app reads or writes Firestore from the browser, so these
// rules exist only as a defense-in-depth net against direct client/REST
// access with the public API key — deny-by-default, open to authenticated
// CMS users only. `sites/{siteId}` holds both `draft` and `published` in one
// document (see PLAN-DESARROLLO.md section 3), so a public "published only"
// read isn't expressible at the document level without exposing `draft` too.
service cloud.firestore {
  match /databases/{database}/documents {
    match /sites/{siteId} {
      allow read, write: if request.auth != null;

      match /versions/{versionId} {
        allow read, write: if request.auth != null;
      }
    }

    match /media/{mediaId} {
      allow read, write: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
